	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@notionhq/client": "^2.2.15",
		"discord.js": "^14.16.0"
	},
	"devDependencies": {
		"@types/node": "^22.9.0",
		"tsx": "^4.20.6",
		"typescript": "^5.8.0"
	}
}
